# Keep this file server-side. Alternatively point TWIN_ENV_FILE at your existing .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
# Enable only when the machine has a broken IPv6 route to the provider.
TWIN_IPV4_ONLY=false
TWIN_ALLOWED_ORIGINS=http://127.0.0.1:4175,http://localhost:4175
# Use discord on a hosted function without durable disk storage.
# This sends consented contact details to Discord; unanswered questions are not saved.
TWIN_RECORD_MODE=file
# Optional Discord notifications for consented contact submissions only.
TWIN_DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=
