# Empty endpoint enables the clearly labeled curated preview (no model call).
# Use the complete HTTPS URL including /chat for the deployed FastAPI service.
NEXT_PUBLIC_CHAT_ENDPOINT=
# Optional: defaults to the bundled resume. Use a trusted HTTPS URL if overriding.
NEXT_PUBLIC_RESUME_URL=
# Existing VITE_CHAT_ENDPOINT and VITE_RESUME_URL settings remain supported aliases.
# Optional static hosting prefix; leave empty locally. GitHub Pages uses /Portfolio.
NEXT_PUBLIC_BASE_PATH=
